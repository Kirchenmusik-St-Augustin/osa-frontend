# Copy to ".env" (or ".env.local") for local `npm run dev`. Vite only
# picks up VITE_-prefixed variables at build/dev time -- they end up in the
# browser bundle and are therefore public. Never put secrets here.
#
# In production (the Docker image), these VITE_ variables are NOT used --
# the container instead reads runtime env vars without the VITE_ prefix
# (API_BASE_URL, APP_ENVIRONMENT), rendered into config.js by
# docker/docker-entrypoint.d/40-generate-runtime-config.sh on every
# container start. See src/runtimeConfig.ts for the read order.

VITE_APP_ENVIRONMENT=development

# Default (see src/runtimeConfig.ts) is the same-origin relative path /api,
# which is correct for the Caddy dev split -- only set this if you need to
# point at a different backend.
VITE_API_BASE_URL=/api
